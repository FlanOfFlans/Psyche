[gd_scene load_steps=7 format=3 uid="uid://wpvdq0a2yf6t"]

[ext_resource type="Script" path="res://addons/freecam_3D/freecam.gd" id="1_p18lu"]

[sub_resource type="GDScript" id="GDScript_aprup"]
script/source = "extends Node3D

@export var fast_forward_factor: float = 2.0;
@export var start_pos: Vector3;
@export var rho: float;
@export var sigma: float;
@export var beta: float;

@onready var multimesh: MultiMeshInstance3D = %MultiMeshInstance3D;

var pos: Vector3;
var speed_up: bool = false;
var base_physics_ticks: int;
var base_timescale: float;

#var lines: Array[MeshInstance3D] = [];
var line_count = 0;

func _ready() -> void:
	pos = start_pos;
	base_physics_ticks = Engine.physics_ticks_per_second;
	base_timescale = Engine.time_scale;

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"speed_up\"):
		if speed_up:
			speed_up = false;
			Engine.physics_ticks_per_second = base_physics_ticks;
			Engine.time_scale = base_timescale;
		
		else:
			speed_up = true;
			Engine.physics_ticks_per_second = base_physics_ticks * fast_forward_factor;
			Engine.time_scale = base_timescale * fast_forward_factor;
	
	if Input.is_action_just_pressed(\"reset\"):
		pos = start_pos;
		line_count = 0;
		multimesh.multimesh.visible_instance_count = 0;
		

func _physics_process(delta: float) -> void:
	var new_pos = calculate_next_step(delta);
	draw_line(pos, new_pos);
	pos = new_pos;

func draw_line(pos, new_pos):
	if (line_count >= multimesh.multimesh.instance_count):
		print(\"Increasing mesh instance size\");
		var transforms = [];
		for i in line_count:
			transforms.append(multimesh.multimesh.get_instance_transform(i));
		multimesh.multimesh.instance_count *= 2;
		for i in line_count:
			multimesh.multimesh.set_instance_transform(i, transforms[i]);
		
	
	var mid_pos = (new_pos + pos) / 2.0;

	var current_dir = Vector3.UP;
	
	var perpendicular = new_pos.cross(Vector3.UP);
	if perpendicular.length() == 0:
		perpendicular = new_pos.cross(Vector3.RIGHT);
	
	var transform = Transform3D().looking_at(new_pos - pos, perpendicular);
	transform = transform.rotated_local(Vector3.RIGHT, PI/2.0);
	transform = transform.translated(mid_pos);

	transform = transform.scaled_local(Vector3.UP * pos.distance_to(new_pos) + Vector3(1, 0, 1));
	
	
	multimesh.multimesh.set_instance_transform(line_count, transform);
	#lines.append(await Draw3D.line(pos, new_pos, Color.GOLD, 0));
	
	multimesh.multimesh.visible_instance_count += 1;
	line_count += 1;

func calculate_next_step(delta):
	var dx = sigma*(pos.y - pos.x);
	var dy = pos.x*(rho - pos.z) - pos.y;
	var dz = pos.x * pos.y - beta * pos.z;
	var new_pos = Vector3(pos.x + dx * delta, pos.y + dy * delta, pos.z + dz * delta);
	
	return new_pos;
"

